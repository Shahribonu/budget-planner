# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://localhost:5432/budget_planner?sslmode=disable
# From @BotFather. Without it the API runs and the bot is off.
TELEGRAM_BOT_TOKEN=
# polling (default in development: no public URL needed), webhook (default in production) or off.
BOT_MODE=
# webhook mode only: public HTTPS base URL of this server, and a random secret.
PUBLIC_URL=
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS URL of the Mini App; enables "Open app" and "Edit" buttons in the bot.
MINIAPP_URL=
# Optional: Claude Haiku category fallback for text the keyword rules don't know.
ANTHROPIC_API_KEY=
# Speech-to-text provider for voice notes; "none" until one is chosen by cmd/sttbench.
STT_PROVIDER=none
# development enables "Authorization: dev <telegram id>" for testing outside Telegram.
APP_ENV=development
PORT=8080
# Apply migrations on start.
MIGRATE=true
# Integration tests use this database and are skipped when unset.
TEST_DATABASE_URL=postgres://localhost:5432/budget_planner_test?sslmode=disable
