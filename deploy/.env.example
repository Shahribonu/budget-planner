# Copy to deploy/.env on the server (chmod 600). Never commit the real file.
DOMAIN=budget.example.uz
POSTGRES_PASSWORD=change-me-long-random
TELEGRAM_BOT_TOKEN=
# Any long random string; Telegram sends it back with every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Optional: Claude Haiku fallback for categories.
ANTHROPIC_API_KEY=
# Optional: voice notes. none, aisha or uzbekvoice, with that provider's key.
STT_PROVIDER=none
AISHA_API_KEY=
UZBEKVOICE_API_KEY=
