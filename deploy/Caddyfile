{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy app:8080 {
		# The app reads the client address from X-Forwarded-For, which Caddy sets.
		# Drop headers a client could use to fake its address and dodge rate limits.
		header_up -X-Real-IP
		header_up -True-Client-IP
	}
}

# ibodat (github.com/Shahribonu/daily-prayer), its own compose stack on the shared "web" network.
prayer.92-5-91-174.sslip.io {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy ibodat-app:8080 {
		header_up -X-Real-IP
		header_up -True-Client-IP
	}
}
